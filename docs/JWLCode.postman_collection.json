    {
      "name": "Judge Service",
      "item": [
        {
          "name": "判题结果回调",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-JWL-Timestamp",
                "value": "{{callback_timestamp}}",
                "type": "text"
              },
              {
                "key": "X-JWL-Signature",
                "value": "sha256={{callback_signature}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/jwlcode.api.v1.judge_callback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "jwlcode.api.v1.judge_callback"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"event-{{$guid}}\",\n  \"judge_request_id\": \"judge-10086\",\n  \"submission_id\": \"{{submission_id}}\",\n  \"status\": \"ACCEPTED\",\n  \"status_version\": 3,\n  \"score\": 100,\n  \"time_ms\": 42,\n  \"memory_kb\": 8192,\n  \"compiler_message\": null,\n  \"output\": null,\n  \"finished_at\": \"2026-08-31T08:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "pm.collectionVariables.set('callback_timestamp', timestamp);",
                  "const rawBody = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.request.body.raw = rawBody;",
                  "const secret = pm.collectionVariables.get('callback_secret');",
                  "const signature = CryptoJS.HmacSHA256(`${timestamp}.${rawBody}`, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('callback_signature', signature);"
                ]
              }
            }
          ]
        }
      ]
    },
