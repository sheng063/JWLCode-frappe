{
	"doctype": "DocType",
	"name": "LMS Game",
	"module": "LMS",
	"engine": "InnoDB",
	"autoname": "hash",
	"title_field": "title",
	"field_order": [
		"title",
		"enabled",
		"filename",
		"html_base64",
		"description",
		"cover_image",
		"entry_file",
		"runtime_mode",
		"active_release"
	],
	"fields": [
		{
			"fieldname": "title",
			"label": "Title",
			"fieldtype": "Data",
			"reqd": 1
		},
		{
			"fieldname": "enabled",
			"label": "Enabled for Students",
			"fieldtype": "Check",
			"default": "1"
		},
		{
			"fieldname": "filename",
			"label": "Filename",
			"fieldtype": "Data",
			"reqd": 1
		},
		{
			"fieldname": "html_base64",
			"label": "HTML Content (Base64)",
			"fieldtype": "Long Text",
			"hidden": 1,
			"reqd": 1
		},
		{
			"fieldname": "description",
			"label": "Description",
			"fieldtype": "Small Text"
		},
		{
			"fieldname": "cover_image",
			"label": "Cover Image",
			"fieldtype": "Long Text",
			"hidden": 1
		},
		{
			"fieldname": "entry_file",
			"fieldtype": "Data",
			"label": "ZIP Entry File",
			"read_only": 1,
			"length": 512
		},
		{
			"fieldname": "runtime_mode",
			"label": "Runtime Mode",
			"fieldtype": "Select",
			"options": "Static\nColyseus",
			"default": "Static"
		},
		{
			"fieldname": "active_release",
			"label": "Active Release",
			"fieldtype": "Link",
			"options": "LMS Game Release",
			"read_only": 1
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1
		},
		{
			"role": "Moderator",
			"read": 1
		},
		{
			"role": "Course Creator",
			"read": 1
		}
	],
	"sort_field": "creation",
	"sort_order": "DESC"
}
