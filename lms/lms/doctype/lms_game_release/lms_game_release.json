      "reqd": 1
    },
    {
      "fieldname": "client_sha256",
      "label": "Client Sha256",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "html_base64",
      "label": "Html Base64",
      "fieldtype": "Long Text",
      "reqd": 1,
