{
  "doctype": "DocType",
  "name": "LMS Game Student Access",
  "module": "LMS",
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "student",
    "required_course",
    "required_lesson",
    "access_mode",
    "reason"
  ],
  "fields": [
    {
      "fieldname": "student",
      "label": "Student",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "required_course",
      "label": "Required Course (empty inherits default)",
      "fieldtype": "Link",
      "options": "LMS Course"
    },
    {
      "fieldname": "required_lesson",
      "fieldtype": "Link",
      "options": "Course Lesson",
      "label": "Required Lesson (empty requires entire course)"
    },
    {
      "fieldname": "access_mode",
      "label": "Access Mode",
      "fieldtype": "Select",
      "options": "Automatic\nAllow\nDeny",
      "default": "Automatic",
      "reqd": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1
    },
    {
      "role": "Moderator",
      "read": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}
